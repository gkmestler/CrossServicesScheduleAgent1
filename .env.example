# ---------------------------------------------------------------------------
# The Furies Scheduler
#
# Copy to .env.local and fill in. Only APP_PASSWORD and SESSION_SECRET are
# required to start: without the others the app degrades to rule-based parsing,
# straight-line distance estimates and a local JSON file, and says so on screen.
# ---------------------------------------------------------------------------

# REQUIRED. The single password gate. Job notes contain door codes and lockbox
# combinations, so the app must not be reachable without this.
APP_PASSWORD=

# REQUIRED. Signs the session cookie. At least 16 characters.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# AI parsing and team suggestions. Without it, parsing falls back to the
# deterministic rules in lib/parse/rules.ts.
ANTHROPIC_API_KEY=

# Optional. Overrides the model. The build spec names claude-opus-4-8;
# claude-opus-5 is a drop-in upgrade at the same price.
# ANTHROPIC_MODEL=claude-opus-4-8

# Server-side only. Geocoding + Routes (distance matrix) APIs.
# Restrict this key to those two APIs. Without it, distances fall back to
# straight-line estimates and locations to town centroids.
GOOGLE_MAPS_API_KEY=

# Client-side. Maps JavaScript API only, restricted by HTTP referrer.
# This is a SEPARATE key from the one above and is exposed to the browser.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Supabase Postgres, pooled Supavisor connection string in TRANSACTION mode
# (port 6543) — Vercel serverless functions need pooling.
# Without it, schedules are stored in a local .data/scheduler.json file.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
